# --- required ---
# python -c "import secrets; print(secrets.token_hex(32))"
HOOK_SECRET_KEY=
POSTGRES_PASSWORD=change-me

# --- optional ---
PORT=8080
WEB_CONCURRENCY=2
HOOK_FLOOD_THRESHOLD=10
HOOK_TARPIT_MAX_MS=15000
HOOK_TOKEN_TTL_HOURS=12
HOOK_DOCS=1
LOG_LEVEL=INFO

# --- local run without Docker (python main.py) ---
# DATABASE_URL=sqlite:///./hook_cloud.db      (run `alembic upgrade head` first)
# REDIS_URL=redis://localhost:6379/0           (empty = in-memory fallback, ONE worker only)
